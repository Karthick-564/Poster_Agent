# ComfyUI on the GPU PC (start it there with --listen 0.0.0.0)
COMFYUI_URL=http://192.168.x.x:8188

# VectorCraft native CLI (MCP server mode is launched by our client)
VECTORCRAFT_CLI=tools/vectorcraft-0.21.0/vectorcraft-0.21.0-windows-x64-portable/vectorcraft-cli.exe

# LLM providers (planner / critic / polish may each use a different one)
GEMINI_API_KEY=
GROQ_API_KEY=
