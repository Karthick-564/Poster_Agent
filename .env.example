# ComfyUI on the GPU PC (start it there with --listen 0.0.0.0)
COMFYUI_URL=http://192.168.x.x:8188

# VectorCraft native CLI (MCP server mode is launched by our client)
VECTORCRAFT_CLI=tools/vectorcraft-0.21.0/vectorcraft-0.21.0-windows-x64-portable/vectorcraft-cli.exe

# LLM providers (planner / critic / polish may each use a different one)
GEMINI_API_KEY=
GROQ_API_KEY=

# Local vision model for the critic (OpenAI-compatible endpoint, e.g. LFM3-VL-2B). Default: the ComfyUI host on port 8080.
VLM_URL=
VLM_MODEL=LFM3-VL-2B

# Planner: a local command-line LLM agent (path to its executable) used for one fresh, tool-less session per request.
# Leave empty to plan with the Gemini / Groq keys above.
PLANNER_CLI=
PLANNER_MODEL=sonnet

# Which image model paints poster backgrounds: qwen | flux | ideogram (default flux when unset)
BACKGROUND_BACKEND=qwen
